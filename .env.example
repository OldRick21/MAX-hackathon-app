BOT_TOKEN=YOUR_BOT_TOKEN
# Generate each secret locally: openssl rand -hex 32
CURSOR_SECRET_KEY=
# Exact public core issuer; keep stable across restarts
JWT_ISSUER=https://195.133.197.144
# Точный origin ядра-клиента (родитель iframe)
SHELL_ORIGIN=https://195.133.197.144
# Origin облачного администрирования (порт 8444 этого сервера), без завершающего /
ADMINISTRATION_PUBLIC_ORIGIN=https://195.133.197.144:8444
# Облачные сервисы: ключ вывода секретов и токены раннеров (каждый — openssl rand -hex 32;
# scripts/deploy.sh создаёт недостающие сам). Сохраняйте между перезапусками.
CLOUD_BINDING_KEY=
ADMINISTRATION_PROVISIONING_TOKEN=
SCHEDULE_PROVISIONING_TOKEN=
USER_PROFILE_PROVISIONING_TOKEN=
# Пароль пульта оператора (https://<сервер>:8445), не короче 12 символов: openssl rand -base64 18
# Смена пароля + перезапуск operator завершает все сессии пульта.
OPERATOR_PASSWORD=
