BOT_TOKEN=YOUR_BOT_TOKEN
# Generate each secret locally: openssl rand -hex 32
CURSOR_SECRET_KEY=
# Exact public core issuer; keep stable across restarts
JWT_ISSUER=https://195.133.197.144
# Ключ вывода machine-секретов облачных сервисов (смена + перезапуск = ротация)
CLOUD_BINDING_KEY=
# Токен, которым процесс administration читает свои bindings у ядра
ADMINISTRATION_PROVISIONING_TOKEN=
# Такой же отдельный токен для процесса сервиса «Люди»; чужой токен не подходит
USER_PROFILE_PROVISIONING_TOKEN=
# Отдельный токен процесса расписания; чужой токен не подходит
SCHEDULE_PROVISIONING_TOKEN=
# Локальный сервис курсовых (docker compose --profile coursework): эти строки выдаёт
# админка на шаге «Ключ доступа». Без них основной стек работает как обычно.
# CORE_URL=
# COURSEWORK_CLIENT_ID=
# COURSEWORK_CLIENT_SECRET=
# COURSEWORK_API_BASE_URL=
# COURSEWORK_CLIENT_BASE_URL=
# Точный origin ядра-клиента (родитель iframe)
SHELL_ORIGIN=https://195.133.197.144
# Отдельный origin сервиса администрирования, без завершающего /
ADMINISTRATION_PUBLIC_ORIGIN=https://195.133.197.144:8444
