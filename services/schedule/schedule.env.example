# Расписание: настройки одного вуза. Файл не попадает в Git.
#   cp schedule.env.example schedule-<вуз>.env && chmod 600 schedule-<вуз>.env
# Команды compose: docker compose --env-file schedule-<вуз>.env ...

# --- Экземпляр ---
# Короткое имя вуза латиницей: из него строятся имена контейнеров и тома данных.
INSTANCE=main

# --- HTTPS-вход ---
# DNS-имя, одобренное в пульте оператора («Обзор» → «Хосты своих сервисов»), внешний порт, имя сертификата.
SERVICE_HOST=schedule.195-133-197-144.sslip.io
SERVICE_PORT=9445
CERT_NAME=schedule-main
# Каталог проверок Let's Encrypt Nginx ядра на порту 80 (на отдельном сервере вуза не нужен).
ACME_WEBROOT=/var/lib/max-miniapp/acme

# --- Подключение к ядру ---
# Регистрация: админка вуза или пульт → «Сервисы» → «Подключить свой сервис», код schedule.
# Строки ниже выдаёт «Выдать ключ» в карточке сервиса; адреса совпадают с указанными при регистрации.
CORE_URL=https://195.133.197.144
SHELL_ORIGIN=https://195.133.197.144
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=
SERVICE_API_BASE_URL=https://schedule.195-133-197-144.sslip.io:9445/api/v1
SERVICE_CLIENT_BASE_URL=https://schedule.195-133-197-144.sslip.io:9445
