# Администрирование: настройки одного вуза. Файл не попадает в Git.
#   cp administration.env.example administration-<вуз>.env && chmod 600 administration-<вуз>.env
# Команды compose: docker compose --env-file administration-<вуз>.env ...

# --- Экземпляр ---
# Короткое имя вуза латиницей: из него строятся имена контейнеров и тома данных.
INSTANCE=main

# --- HTTPS-вход ---
# DNS-имя, одобренное в пульте оператора («Обзор» → «Хосты своих сервисов»), внешний порт, имя сертификата.
SERVICE_HOST=admin.195-133-197-144.sslip.io
SERVICE_PORT=9444
CERT_NAME=admin-main
# Каталог проверок Let's Encrypt Nginx ядра на порту 80 (на отдельном сервере вуза не нужен).
ACME_WEBROOT=/var/lib/max-miniapp/acme

# --- Подключение к ядру ---
# Ключ и адреса администрирования задаёт оператор: пульт → «Вузы» → вуз → «Сервисы» → «Администрирование».
# Строки ниже выдаёт «Выдать ключ» в карточке сервиса; адреса совпадают с указанными при регистрации.
CORE_URL=https://195.133.197.144
SHELL_ORIGIN=https://195.133.197.144
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=
SERVICE_API_BASE_URL=https://admin.195-133-197-144.sslip.io:9444/api/v1
SERVICE_CLIENT_BASE_URL=https://admin.195-133-197-144.sslip.io:9444
# Дополнительные родители iframe (MAX Web).
FRAME_ANCESTORS=https://web.max.ru
