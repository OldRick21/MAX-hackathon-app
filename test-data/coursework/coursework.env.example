# Все настройки сервиса курсовых — только здесь. С платформенным .env не пересекается.
#   cp coursework.env.example coursework.env && chmod 600 coursework.env && nano coursework.env
# Команды compose запускаются с этим файлом:  docker compose --env-file coursework.env ...

# --- HTTPS-вход сервиса ---
# DNS-имя, одобренное в пульте оператора («Обзор» → «Хосты своих сервисов»), и внешний порт.
COURSEWORK_HOST=coursework.195-133-197-144.sslip.io
COURSEWORK_PORT=9443
# Каталог, куда Nginx на порту 80 кладёт проверки Let's Encrypt. На сервере платформы порт 80
# занят её Nginx, поэтому указывается её webroot — это единственная точка соприкосновения.
# На отдельном сервере вуза не нужен: сертификат выпускается в режиме --standalone.
ACME_WEBROOT=/var/lib/max-miniapp/acme

# --- Подключение к ядру ---
# Строки выдаёт пульт оператора («Сервисы» → карточка сервиса → «Выдать ключ»).
# Адреса должны совпадать с указанными при регистрации сервиса.
CORE_URL=https://195.133.197.144
SHELL_ORIGIN=https://195.133.197.144
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=
SERVICE_API_BASE_URL=https://coursework.195-133-197-144.sslip.io:9443/api/v1
SERVICE_CLIENT_BASE_URL=https://coursework.195-133-197-144.sslip.io:9443
