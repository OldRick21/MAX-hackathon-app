# Подставляется образом nginx (envsubst): COURSEWORK_HOST, COURSEWORK_CERT.
server {
    listen 443 ssl;
    server_name ${COURSEWORK_HOST};
    ssl_certificate /etc/letsencrypt/live/${COURSEWORK_CERT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${COURSEWORK_CERT}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # PDF до 20 МБ плюс поля формы: весь multipart до 21 МБ.
    client_max_body_size 21m;

    location / {
        proxy_pass http://app:8400;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
