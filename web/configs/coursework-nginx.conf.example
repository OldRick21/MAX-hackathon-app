# Пример HTTPS-входа для локального сервиса курсовых на том же сервере (демо).
# 1. Замените coursework.example.ru на одобренный поддержкой хост (нужно DNS-имя, IP не подходит).
# 2. Выпустите сертификат для этого имени в /var/lib/max-miniapp/letsencrypt (certbot --webroot, /var/www/acme).
# 3. Смонтируйте файл в web как /etc/nginx/conf.d/coursework.conf и перезапустите web.
server {
    listen 443 ssl;
    server_name coursework.example.ru;
    ssl_certificate /etc/letsencrypt/live/coursework/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coursework/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # PDF до 20 МБ плюс поля формы (SPEC курсовых: весь multipart до 21 МБ).
    client_max_body_size 21m;

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $coursework coursework:8400;
        proxy_pass http://$coursework;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
